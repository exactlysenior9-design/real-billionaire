// Socket.IO Management
const meetingRooms = new Map();
const onlineUsers = new Set();

io.on('connection', (socket) => {
  console.log('New client connected:', socket.id);

  // User authentication
  socket.on('authenticate', (userId) => {
    socket.userId = userId;
    onlineUsers.add(userId);
    socket.join(`user_${userId}`);
    io.emit('userOnline', userId);
    console.log(`User ${userId} authenticated`);
  });

  // Private messaging
  socket.on('privateMessage', async (data) => {
    const { to, message } = data;
    const messageData = {
      ...message,
      senderId: socket.userId,
      receiverId: to,
      timestamp: new Date().toISOString(),
    };
    
    // Save to database
    await Message.create(messageData);
    
    // Send to receiver if online
    io.to(`user_${to}`).emit('newMessage', messageData);
    // Also send back to sender for confirmation
    socket.emit('messageSent', messageData);
  });

  // Meeting management
  socket.on('createMeeting', async (data) => {
    const meetingId = data.id;
    meetingRooms.set(meetingId, {
      ...data,
      participants: [{
        id: data.hostId,
        name: data.hostName,
        socketId: socket.id,
        role: 'host',
      }],
    });
    
    socket.join(`meeting_${meetingId}`);
    socket.emit('meetingCreated', { meetingId });
    
    // Broadcast to all users that a meeting is available
    io.emit('meetingAvailable', { meetingId, topic: data.topic });
  });

  socket.on('joinMeeting', async (data) => {
    const { meetingId, participant } = data;
    const meeting = meetingRooms.get(meetingId);
    
    if (meeting) {
      if (meeting.participants.length >= meeting.maxParticipants) {
        socket.emit('meetingFull', { meetingId });
        return;
      }
      
      meeting.participants.push({
        ...participant,
        socketId: socket.id,
        role: 'participant',
      });
      
      socket.join(`meeting_${meetingId}`);
      io.to(`meeting_${meetingId}`).emit('participantJoined', {
        participant,
        meetingId,
      });
      
      // Send current participants to new user
      socket.emit('meetingJoined', {
        meetingId,
        participants: meeting.participants,
        topic: meeting.topic,
      });
    } else {
      socket.emit('meetingNotFound', { meetingId });
    }
  });

  socket.on('leaveMeeting', (data) => {
    const { meetingId } = data;
    const meeting = meetingRooms.get(meetingId);
    
    if (meeting) {
      const participantIndex = meeting.participants.findIndex(
        p => p.id === socket.userId
      );
      
      if (participantIndex !== -1) {
        meeting.participants.splice(participantIndex, 1);
        io.to(`meeting_${meetingId}`).emit('participantLeft', {
          participantId: socket.userId,
          meetingId,
        });
      }
      
      socket.leave(`meeting_${meetingId}`);
      
      // If host left, end meeting
      if (meeting.hostId === socket.userId) {
        io.to(`meeting_${meetingId}`).emit('meetingEnded', { meetingId });
        meetingRooms.delete(meetingId);
      }
    }
  });

  // WebRTC signaling
  socket.on('offer', (data) => {
    const { to, sdp } = data;
    io.to(`user_${to}`).emit('offer', {
      from: socket.userId,
      sdp,
    });
  });

  socket.on('answer', (data) => {
    const { to, sdp } = data;
    io.to(`user_${to}`).emit('answer', {
      from: socket.userId,
      sdp,
    });
  });

  socket.on('ice-candidate', (data) => {
    const { to, candidate } = data;
    io.to(`user_${to}`).emit('ice-candidate', {
      from: socket.userId,
      candidate,
    });
  });

  // Status updates
  socket.on('newStatus', async (data) => {
    await Status.create(data);
    io.emit('newStatus', data);
  });

  // Disconnect
  socket.on('disconnect', () => {
    if (socket.userId) {
      onlineUsers.delete(socket.userId);
      io.emit('userOffline', socket.userId);
      
      // Check if user was in any meeting
      meetingRooms.forEach((meeting, meetingId) => {
        const participantIndex = meeting.participants.findIndex(
          p => p.id === socket.userId
        );
        if (participantIndex !== -1) {
          meeting.participants.splice(participantIndex, 1);
          io.to(`meeting_${meetingId}`).emit('participantLeft', {
            participantId: socket.userId,
            meetingId,
          });
        }
      });
    }
    console.log('Client disconnected:', socket.id);
  });
});

// Twilio OTP Service
const twilioClient = twilio(
  process.env.TWILIO_ACCOUNT_SID,
  process.env.TWILIO_AUTH_TOKEN
);

app.post('/api/send-otp', async (req, res) => {
  const { phoneNumber } = req.body;
  try {
    const otp = Math.floor(100000 + Math.random() * 900000).toString();
    // Store OTP in database with expiry
    await OTP.create({
      phoneNumber,
      otp,
      expiresAt: new Date(Date.now() + 5 * 60 * 1000),
    });
    
    // Send via Twilio
    await twilioClient.messages.create({
      body: `Your pChat verification code is: ${otp}`,
      from: process.env.TWILIO_PHONE_NUMBER,
      to: phoneNumber,
    });
    
    res.json({ success: true, message: 'OTP sent successfully' });
  } catch (error) {
    console.error('OTP Error:', error);
    res.status(500).json({ success: false, error: 'Failed to send OTP' });
  }
});

app.post('/api/verify-otp', async (req, res) => {
  const { phoneNumber, otp } = req.body;
  try {
    const otpRecord = await OTP.findOne({
      phoneNumber,
      otp,
      expiresAt: { $gt: new Date() },
    });
    
    if (otpRecord) {
      await OTP.deleteOne({ _id: otpRecord._id });
      res.json({ success: true, message: 'OTP verified' });
    } else {
      res.status(400).json({ success: false, error: 'Invalid OTP' });
    }
  } catch (error) {
    res.status(500).json({ success: false, error: 'Verification failed' });
  }
});

